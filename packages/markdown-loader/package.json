  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrosousa13/pagedeck.git",
    "directory": "packages/markdown-loader"
  },
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
