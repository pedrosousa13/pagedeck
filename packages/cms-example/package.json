{
  "name": "@pagedeck/cms-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "prepack": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@pagedeck/content": "workspace:*",
    "@pagedeck/core": "workspace:*",
    "@pagedeck/islands": "workspace:*",
    "react": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^30.0.1",
    "react-dom": "^19.2.0"
  }
}
