{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pagedeck-landing",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    // The site declares no 404 page, and `site/.assetsignore` keeps the adapter's
    // fallback `404.html` out of the upload.
    "not_found_handling": "none"
  }
}
