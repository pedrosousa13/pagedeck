{
  "name": "@pagedeck/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "source": "./src/components/*.tsx",
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./consent": {
      "source": "./src/consent.ts",
      "types": "./dist/consent.d.ts",
      "default": "./dist/consent.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "prepack": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@pagedeck/brand": "workspace:*",
    "@pagedeck/core": "workspace:*",
    "@pagedeck/islands": "workspace:*",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@pagedeck/content": "workspace:*",
    "@pagedeck/site": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "4.3.3",
    "vite": "^8.2.2"
  }
}
