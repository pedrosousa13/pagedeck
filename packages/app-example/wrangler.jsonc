{
  "name": "pagedeck-app-example",
  "main": "src/app.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api", "/api/*", "/account", "/account/*"]
  },
  "kv_namespaces": [{ "binding": "SESSIONS" }]
}
