{
  "name": "@pagedeck/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./images": {
      "source": "./src/images.ts",
      "types": "./dist/images.d.ts",
      "default": "./dist/images.js"
    },
    "./props": {
      "source": "./src/props.ts",
      "types": "./dist/props.d.ts",
      "default": "./dist/props.js"
    },
    "./content": {
      "source": "./src/content.ts",
      "types": "./dist/content.d.ts",
      "default": "./dist/content.js"
    },
    "./loader": {
      "source": "./src/loader.ts",
      "types": "./dist/loader.d.ts",
      "default": "./dist/loader.js"
    },
    "./parity": {
      "source": "./src/parity.ts",
      "types": "./dist/parity.d.ts",
      "default": "./dist/parity.js"
    },
    "./parity-read": {
      "source": "./src/parity-read.ts",
      "types": "./dist/parity-read.d.ts",
      "default": "./dist/parity-read.js"
    },
    "./deploy-run": {
      "source": "./src/deploy-run.ts",
      "types": "./dist/deploy-run.d.ts",
      "default": "./dist/deploy-run.js"
    },
    "./deploy-target": {
      "source": "./src/deploy-target.ts",
      "types": "./dist/deploy-target.d.ts",
      "default": "./dist/deploy-target.js"
    },
    "./audit-site": {
      "source": "./src/audit-site.ts",
      "types": "./dist/audit-site.d.ts",
      "default": "./dist/audit-site.js"
    },
    "./components/*": {
      "source": "./src/components/*.tsx",
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "prepack": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@pagedeck/adapter-cloudflare-worker": "workspace:*",
    "@pagedeck/adapter-cloudfront": "workspace:*",
    "@pagedeck/adapter-netlify": "workspace:*",
    "@pagedeck/adapter-nginx": "workspace:*",
    "@pagedeck/brand": "workspace:*",
    "@pagedeck/content": "workspace:*",
    "@pagedeck/core": "workspace:*",
    "@pagedeck/design-system": "workspace:*",
    "@pagedeck/edge": "workspace:*",
    "@pagedeck/font-subset": "workspace:*",
    "@pagedeck/islands": "workspace:*",
    "@pagedeck/social-image": "workspace:*",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axe-core": "^4.13.0",
    "chrome-launcher": "^1.2.1",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "react-dom": "^19.2.0",
    "tailwindcss": "4.3.3"
  }
}
